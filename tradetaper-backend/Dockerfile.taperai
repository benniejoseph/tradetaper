# Dockerfile for the standalone TaperAI Desk service (Cloud Run: taperai-desk)

# --- Builder Stage ---
FROM node:20-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npx tsc -p tsconfig.build.json --skipLibCheck

# --- Production Stage ---
FROM node:20-slim AS production
WORKDIR /app
COPY package*.json ./
RUN npm install --production
COPY --from=builder /app/dist ./dist
EXPOSE 8080
CMD ["node", "dist/taper-ai-standalone/main"]
